[Unit]
Description=Remote Play Video: a stream (Remote Play, AirPlay) on the car's screen through the head unit's hardware decoder, and a USB gamepad

[Service]
# Settings: /var/opt/ida-remoteplay-video/settings.json (decoder, sink, sinkProps; read at start and at each probe).
ExecStart=/usr/bin/node /var/opt/ida-remoteplay-video/current/video.js
# the car's system.conf has DefaultStandardOutput=null: the log would never reach the journal
StandardOutput=journal
# the app's control socket and the engine's stream socket: /run/ida-remoteplay-video/ (0666, the app runs as its own uid)
RuntimeDirectory=ida-remoteplay-video
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
