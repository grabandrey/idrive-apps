{
  "name": "ida_drlcolor",
  "version": "1.0.0",
  "description": "Switches an aftermarket DRL module between yellow and white by flashing the high beams three times",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 5242880,
    "cpuLimit": 20,
    "memoryThresholdKB": 65536,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "DRLC",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "LICENSE"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "DrlColour",
  "license": "MIT",
  "mguHmi": [
    "ID8"
  ],
  "mguAppStartType": "autostart"
}
